{
  "_opis": "Konfiguracja monitora bezpieczenstwa. Zmiana tego klucza nie wymaga wdrozenia kodu.",
  "maxSubrequests": 45,
  "hostsPerRun": 4,
  "requestTimeoutMs": 10000,
  "digestCron": "0 6 * * *",
  "alerts": {
    "minStatus": "warn",
    "notifyOnRecovery": true
  },
  "targets": [
    {
      "host": "auraconsulting.pl",
      "zone": "auraconsulting.pl",
      "probePaths": [
        "/.env",
        "/.git/config",
        "/config.json"
      ],
      "checkHttpRedirect": true,
      "checkSecurityTxt": true,
      "checkCspPipeline": false,
      "expect": {
        "csp": "any",
        "hstsMinAge": 15552000
      }
    },
